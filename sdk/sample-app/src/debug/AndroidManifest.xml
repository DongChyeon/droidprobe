<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <meta-data
            android:name="dev.droidprobe.SETUP"
            android:value="dev.droidprobe.sample.SampleProbeSetup" />

        <!-- Test trigger standing in for a checkout button: am broadcast -a dev.droidprobe.sample.CONFIRM_ORDER -p dev.droidprobe.sample -->
        <receiver
            android:name=".OrderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.droidprobe.sample.CONFIRM_ORDER" />
                <action android:name="dev.droidprobe.sample.RESET" />
                <action android:name="dev.droidprobe.sample.EMIT_EVENTS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
